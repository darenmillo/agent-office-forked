{
    "compilerOptions": {
        "target": "ES2021",
        "module": "CommonJS",
        "moduleResolution": "node",
        "lib": ["ES2021", "DOM"],
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": false,
        "declaration": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.test.ts", "dist", "node_modules"]
}
